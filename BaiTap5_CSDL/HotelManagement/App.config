<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup><supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" /></startup>
  <connectionStrings>
    <add name="CafePOSDB" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=CafePOSDB;Integrated Security=True;Encrypt=False;Connect Timeout=15" providerName="System.Data.SqlClient" />
    <add name="HotelDB" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=HotelDB;Integrated Security=True;Encrypt=False;Connect Timeout=15" providerName="System.Data.SqlClient" />
    <add name="InventoryDB" connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=InventoryDB;Integrated Security=True;Encrypt=False;Connect Timeout=15" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
